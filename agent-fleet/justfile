#!/usr/bin/env just --justfile

set dotenv-load
set positional-arguments

ssh_key := justfile_directory() + "/ssh/id_ed25519"
known_hosts := justfile_directory() + "/known_hosts"

[private]
_for-hosts recipe host="" *args:
    #!/usr/bin/env bash
    set -euo pipefail

    recipe=$1
    requested_hosts=$2
    shift 2

    fleet=$(jq -ce \
        'if type == "object" and length > 0 then . else error("fleet must be a non-empty object") end' \
        nix/fleet.json)

    if [[ -z "$requested_hosts" ]]; then
        mapfile -t hosts < <(jq -r 'keys[]' <<<"$fleet")
    else
        if [[ "$requested_hosts" == ,* || "$requested_hosts" == *, || "$requested_hosts" == *,,* ]]; then
            echo "Host lists cannot contain empty hostnames." >&2
            exit 1
        fi
        IFS=',' read -r -a hosts <<<"$requested_hosts"
    fi

    for host in "${hosts[@]}"; do
        if ! jq -e --arg host "$host" 'has($host)' <<<"$fleet" >/dev/null; then
            echo "Unknown host: $host" >&2
            exit 1
        fi
    done

    for host in "${hosts[@]}"; do
        just "$recipe" "$host" "$@"
    done

default:
    @just --list

# Format Terraform and Nix files.
fmt:
    tofu fmt -recursive
    nixfmt nix/*.nix

# Check Terraform and evaluate every NixOS host.
check:
    tofu fmt -check -recursive
    tofu validate
    nix flake check ./nix --no-build

# Initialize OpenTofu and install providers.
tf-init:
    tofu init

# Show the infrastructure changes.
tf-plan *args:
    tofu plan {{ args }}

# Apply the infrastructure changes.
tf-apply *args: && ssh-config
    tofu apply {{ args }}

# Create cloud resources, then install NixOS on the selected hosts.
create host="": tf-apply
    just _for-hosts _install "$@"

# Destroy cloud resources after confirmation.
tf-destroy *args: && ssh-config
    tofu destroy {{ args }}

# Print the selected hosts' public IPv4 addresses.
host-ip host="":
    just _for-hosts _host-ip "$@"

[private]
_host-ip host:
    @tofu output -json server_ips | jq -er --arg host "{{ host }}" '.[$host]'

# Update the generated fleet entries in the user's SSH configuration.
ssh-config:
    #!/usr/bin/env bash
    set -euo pipefail

    ssh_dir="$HOME/.ssh"
    main_config="$ssh_dir/config"
    fleet_config="$ssh_dir/agent-fleet"
    include='Include ~/.ssh/agent-fleet'
    server_ips=$(tofu output -json server_ips 2>/dev/null || printf '{}')

    jq -e 'type == "object" and all(.[]; type == "string")' \
        <<<"$server_ips" >/dev/null

    mkdir -p "$ssh_dir"
    chmod 700 "$ssh_dir"

    temp_config=$(mktemp "$ssh_dir/agent-fleet.XXXXXX")
    trap 'rm -f "$temp_config"' EXIT
    {
        printf '%s\n\n' '# Generated by agent-fleet. Run `just ssh-config` to update.'
        jq -r \
            --arg identity_file "{{ ssh_key }}" \
            --arg known_hosts_file "{{ known_hosts }}" \
            'to_entries | sort_by(.key)[] |
             "Host \(.key)\n" +
             "    HostName \(.value)\n" +
             "    User robert\n" +
             "    IdentityFile \($identity_file)\n" +
             "    IdentitiesOnly yes\n" +
             "    PasswordAuthentication no\n" +
             "    StrictHostKeyChecking accept-new\n" +
             "    UserKnownHostsFile \($known_hosts_file)\n"' \
            <<<"$server_ips"
    } >"$temp_config"
    chmod 600 "$temp_config"
    mv "$temp_config" "$fleet_config"
    trap - EXIT

    if [[ ! -e "$main_config" ]]; then
        install -m 600 /dev/null "$main_config"
    fi

    if ! grep -Fqx "$include" "$main_config"; then
        temp_config=$(mktemp "$ssh_dir/config.XXXXXX")
        trap 'rm -f "$temp_config"' EXIT
        {
            printf '%s\n\n' "$include"
            cat "$main_config"
        } >"$temp_config"
        chmod 600 "$temp_config"
        mv "$temp_config" "$main_config"
        trap - EXIT
    fi

# Install NixOS on the selected new cloud servers.
install host="":
    just _for-hosts _install "$@"

[private]
_install host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    unset SSH_PRIVATE_KEY
    nixos-anywhere \
        --flake "./nix#{{ host }}" \
        -i "{{ ssh_key }}" \
        --ssh-option "IdentitiesOnly=yes" \
        --ssh-option "ControlMaster=no" \
        --ssh-option "ControlPath=none" \
        --ssh-option "StrictHostKeyChecking=no" \
        --ssh-option "UserKnownHostsFile=/dev/null" \
        "root@$ip"
    just _refresh-host-key {{ host }}
    just _tailscale-login {{ host }}

# Replace the stored SSH host keys after an install or rebuild.
refresh-host-key host="":
    just _for-hosts _refresh-host-key "$@"

[private]
_refresh-host-key host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    mkdir -p "$(dirname "{{ known_hosts }}")"
    touch "{{ known_hosts }}"
    ssh-keygen -f "{{ known_hosts }}" -R "$ip" >/dev/null 2>&1 || true
    for _ in $(seq 1 60); do
        if ssh-keyscan -H "$ip" >> "{{ known_hosts }}" 2>/dev/null; then
            exit 0
        fi
        sleep 2
    done
    echo "Could not read the SSH host key for {{ host }} ($ip)" >&2
    exit 1

# Copy the Nix flake and Cachix credentials to the selected hosts.
sync host="":
    just _for-hosts _sync "$@"

[private]
_sync host:
    #!/usr/bin/env bash
    set -euo pipefail
    netrc_file="/etc/nixos/shared/secrets/hyper-video-cachix-netrc.key"
    test -f "$netrc_file"
    ip=$(just _host-ip {{ host }})
    ssh=(
        ssh
        -i "{{ ssh_key }}"
        -o IdentitiesOnly=yes
        -o ControlMaster=no
        -o ControlPath=none
        -o UserKnownHostsFile="{{ known_hosts }}"
        -o StrictHostKeyChecking=accept-new
    )
    rsync -az --delete \
        --exclude result \
        --exclude /shared/ \
        --rsync-path="sudo rsync" \
        -e "${ssh[*]}" \
        ./nix/ "robert@$ip:/etc/nixos/"
    "${ssh[@]}" "robert@$ip" \
        "sudo install -d -m 700 -o root -g root /etc/nixos/shared/secrets"
    rsync -a \
        --chmod=F600 \
        --chown=root:root \
        --rsync-path="sudo rsync" \
        -e "${ssh[*]}" \
        "$netrc_file" "robert@$ip:$netrc_file"

# Activate the flake already stored on the selected hosts.
switch host="":
    just _for-hosts _switch "$@"

[private]
_switch host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    export NIX_SSHOPTS='-i {{ ssh_key }} -o IdentitiesOnly=yes -o ControlMaster=no -o ControlPath=none -o UserKnownHostsFile={{ known_hosts }} -o StrictHostKeyChecking=accept-new'
    nixos-rebuild switch \
        --flake "./nix#{{ host }}" \
        --target-host "robert@$ip" \
        --sudo

# Copy and activate the current Nix flake.
deploy host="":
    just _for-hosts _deploy "$@"

[private]
_deploy host:
    just _sync {{ host }}
    just _switch {{ host }}
    just _ensure-agent-hooks {{ host }}
    just _sync-skills {{ host }}

# Install or refresh the Claude hooks for Herdr and RTK.
ensure-agent-hooks host="":
    just _for-hosts _ensure-agent-hooks "$@"

[private]
_ensure-agent-hooks host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    ssh \
        -i "{{ ssh_key }}" \
        -o IdentitiesOnly=yes \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o UserKnownHostsFile="{{ known_hosts }}" \
        -o StrictHostKeyChecking=accept-new \
        "robert@$ip" 'bash -s' <<'REMOTE'
    set -euo pipefail
    if [[ ! -f "$HOME/.claude/settings.json" ]]; then
        echo "Claude settings have not synced to this host." >&2
        exit 1
    fi
    herdr integration install claude
    herdr integration install codex
    rtk init --global --hook-only --auto-patch
    REMOTE

# Publish the synced Skillshare source to each configured AI tool.
sync-skills host="":
    just _for-hosts _sync-skills "$@"

[private]
_sync-skills host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    ssh \
        -i "{{ ssh_key }}" \
        -o IdentitiesOnly=yes \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o UserKnownHostsFile="{{ known_hosts }}" \
        -o StrictHostKeyChecking=accept-new \
        "robert@$ip" 'bash -s' <<'REMOTE'
    set -euo pipefail
    if [[ ! -f "$HOME/projects/ai/skillshare/config.yaml" ]]; then
        echo "The Skillshare source has not synced to this host." >&2
        exit 1
    fi
    skillshare sync --all
    REMOTE

# Join the selected new hosts to the tailnet through browser authorization.
tailscale-login host="":
    just _for-hosts _tailscale-login "$@"

[private]
_tailscale-login host:
    just _ssh {{ host }} sudo tailscale up
    just _ssh {{ host }} sudo systemctl restart tailscale-serve-syncthing.service

# Show the Tailscale connection state for the selected hosts.
tailscale-status host="":
    just _for-hosts _tailscale-status "$@"

[private]
_tailscale-status host:
    just _ssh {{ host }} sudo tailscale status

# Print the tailnet-only Syncthing web UI addresses for the selected hosts.
syncthing-ui host="":
    just _for-hosts _syncthing-ui "$@"

[private]
_syncthing-ui host:
    just _ssh {{ host }} sudo tailscale serve status

# Copy local Codex and Claude OAuth credentials to the selected hosts.
sync-auth host="":
    just _for-hosts _sync-auth "$@"

[private]
_sync-auth host:
    #!/usr/bin/env bash
    set -euo pipefail
    test -f "$HOME/.codex/auth.json"
    test -f "$HOME/.claude/.credentials.json"
    ip=$(just _host-ip {{ host }})
    ssh=(
        ssh
        -i "{{ ssh_key }}"
        -o IdentitiesOnly=yes
        -o ControlMaster=no
        -o ControlPath=none
        -o UserKnownHostsFile="{{ known_hosts }}"
        -o StrictHostKeyChecking=accept-new
    )
    "${ssh[@]}" "robert@$ip" 'mkdir -p ~/.codex ~/.claude && chmod 700 ~/.codex ~/.claude'
    rsync -a --chmod=F600 \
        -e "${ssh[*]}" \
        "$HOME/.codex/auth.json" \
        "robert@$ip:.codex/auth.json"
    rsync -a --chmod=F600 \
        -e "${ssh[*]}" \
        "$HOME/.claude/.credentials.json" \
        "robert@$ip:.claude/.credentials.json"

# Print the Syncthing device ID for the selected hosts.
syncthing-id host="":
    just _for-hosts _syncthing-id "$@"

[private]
_syncthing-id host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    ssh \
        -i "{{ ssh_key }}" \
        -o IdentitiesOnly=yes \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o UserKnownHostsFile="{{ known_hosts }}" \
        -o StrictHostKeyChecking=accept-new \
        "robert@$ip" \
        'syncthing device-id --home="$HOME/.config/syncthing"'

# Show Syncthing progress for the three fleet folders.
sync-status host="":
    just _for-hosts _sync-status "$@"

[private]
_sync-status host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    ssh \
        -i "{{ ssh_key }}" \
        -o IdentitiesOnly=yes \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o UserKnownHostsFile="{{ known_hosts }}" \
        -o StrictHostKeyChecking=accept-new \
        "robert@$ip" 'bash -s' <<'REMOTE'
    set -euo pipefail
    api_key=$(syncthing cli -H "$HOME/.config/syncthing" config gui apikey get)
    for folder in configs projects/ai projects/hyper; do
        curl -fsS \
            -H "X-API-Key: $api_key" \
            --get \
            --data-urlencode "folder=$folder" \
            http://127.0.0.1:8384/rest/db/status \
            | jq -c --arg folder "$folder" '{folder: $folder, state: .state, globalBytes: .globalBytes, localBytes: .localBytes, needBytes: .needBytes, errors: .errors}'
    done
    REMOTE

# Open an SSH session as robert, or run the given command.
ssh host="" *command:
    just _for-hosts _ssh "$@"

[private]
_ssh host *command:
    #!/usr/bin/env bash
    set -euo pipefail
    host=$1
    shift
    ip=$(just _host-ip "$host")
    ssh \
        -i "{{ ssh_key }}" \
        -o IdentitiesOnly=yes \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o UserKnownHostsFile="{{ known_hosts }}" \
        -o StrictHostKeyChecking=accept-new \
        "robert@$ip" "$@"

# Build the selected NixOS hosts locally without activating them.
build host="":
    just _for-hosts _build "$@"

[private]
_build host:
    nix build "./nix#nixosConfigurations.{{ host }}.config.system.build.toplevel"

# Update every Nix flake input.
update-inputs:
    nix flake update --flake ./nix

# Update the pinned Moshi hook release.
update-moshi:
    nix shell --inputs-from ./nix nixpkgs#curl -c ./nix/custom/moshi-hook/update.sh

# Pair one fleet host with the Moshi phone app.
pair-moshi host:
    @./nix/custom/moshi-hook/pair.sh "{{ host }}"

# Update every Nix flake input.
update-ai host="":
    #!/usr/bin/env bash
    set -euo pipefail

    nix flake update --flake ./nix \
      ai-quotas \
      ast-outline \
      codex-cli-nix \
      llm-agents \
      herdr-nix \
      skillshare-nix \
      worktrunk-nix

    if git diff --quiet HEAD -- nix/flake.lock; then
        exit 0
    fi

    git add nix/flake.lock
    git commit -m "update ai"
    just _for-hosts _deploy "$@"
