#!/usr/bin/env just --justfile

set dotenv-load
set positional-arguments

ssh_key := justfile_directory() + "/../shared/secrets/agent-fleet-ssh.key"
known_hosts := justfile_directory() + "/known_hosts"

[private]
_for-hosts recipe host="" *args:
    #!/usr/bin/env bash
    set -euo pipefail

    recipe=$1
    requested_hosts=$2
    shift 2

    fleet=$(jq -ce \
        'if type == "object" and length > 0 then . else error("fleet must be a non-empty object") end' \
        nix/fleet.json)

    # Remote recipes only target provisioned hosts; local builds can target any host in fleet.json.
    require_provisioned=true
    if [[ "$recipe" == "_build" ]]; then
        require_provisioned=false
    fi

    server_ips='{}'
    if [[ "$require_provisioned" == "true" ]]; then
        outputs=$(tofu output -json)
        server_ips=$(jq -ce '
            if type == "object" then
                if has("server_ips") then
                    (.server_ips.value // error("missing server_ips value"))
                    | if type == "object" then . else error("server_ips is not an object") end
                else
                    {}
                end
            else
                error("tofu output is not an object")
            end
        ' <<<"$outputs")
    fi

    if [[ -z "$requested_hosts" ]]; then
        if [[ "$require_provisioned" == "true" ]]; then
            mapfile -t hosts < <(jq -r --argjson ips "$server_ips" \
                'keys[] | select(($ips[.] // "") | (type == "string" and length > 0))' \
                <<<"$fleet")
            if [[ ${#hosts[@]} -eq 0 ]]; then
                echo "No provisioned fleet hosts found." >&2
                exit 1
            fi
        else
            mapfile -t hosts < <(jq -r 'keys[]' <<<"$fleet")
        fi
    else
        if [[ "$requested_hosts" == ,* || "$requested_hosts" == *, || "$requested_hosts" == *,,* ]]; then
            echo "Host lists cannot contain empty hostnames." >&2
            exit 1
        fi
        IFS=',' read -r -a hosts <<<"$requested_hosts"
    fi

    for host in "${hosts[@]}"; do
        if ! jq -e --arg host "$host" 'has($host)' <<<"$fleet" >/dev/null; then
            echo "Unknown host: $host" >&2
            exit 1
        fi
        if [[ "$require_provisioned" == "true" ]]; then
            if ! jq -e --arg host "$host" 'has($host) and (.[$host] | type == "string" and length > 0)' <<<"$server_ips" >/dev/null; then
                echo "Host is not currently provisioned: $host" >&2
                exit 1
            fi
        fi
    done

    for host in "${hosts[@]}"; do
        just "$recipe" "$host" "$@"
    done

default:
    @just --list

# Format Terraform and Nix files.
fmt:
    tofu fmt -recursive
    nixfmt nix/*.nix

# Check Terraform and evaluate every NixOS host.
check:
    tofu fmt -check -recursive
    tofu validate
    nix flake check .. --impure --no-build

# Initialize OpenTofu and install providers.
tf-init:
    tofu init

# Show the infrastructure changes.
tf-plan *args:
    tofu plan {{ args }}

# Apply the infrastructure changes.
tf-apply *args: && ssh-config
    tofu apply {{ args }}

# Create cloud resources, then install NixOS on the selected hosts.
create host="": tf-apply
    just _for-hosts _install "$@"

# Destroy cloud resources after confirmation.
tf-destroy *args: && ssh-config
    tofu destroy {{ args }}

# Print the selected hosts' public IPv4 addresses.
host-ip host="":
    just _for-hosts _host-ip "$@"

[private]
_host-ip host:
    @tofu output -json server_ips | jq -er --arg host "{{ host }}" '.[$host]'

# Update the generated fleet entries in the user's SSH configuration.
ssh-config:
    #!/usr/bin/env bash
    set -euo pipefail

    ssh_dir="$HOME/.ssh"
    main_config="$ssh_dir/config"
    fleet_config="$ssh_dir/agent-fleet"
    include='Include ~/.ssh/agent-fleet'
    outputs=$(tofu output -json)
    server_ips=$(jq -ce '
        if type == "object" then
            if has("server_ips") then
                (.server_ips.value // error("missing server_ips value"))
                | if type == "object" and all(.[]; type == "string") then . else error("server_ips must be an object of strings") end
            else
                {}
            end
        else
            error("tofu output is not an object")
        end
    ' <<<"$outputs")

    mkdir -p "$ssh_dir"
    chmod 700 "$ssh_dir"

    temp_config=$(mktemp "$ssh_dir/agent-fleet.XXXXXX")
    trap 'rm -f "$temp_config"' EXIT
    {
        printf '%s\n\n' '# Generated by agent-fleet. Run `just ssh-config` to update.'
        jq -r \
            --arg identity_file "{{ ssh_key }}" \
            --arg known_hosts_file "{{ known_hosts }}" \
            'to_entries | sort_by(.key)[] |
             "Host \(.key)\n" +
             "    HostName \(.value)\n" +
             "    User robert\n" +
             "    IdentityFile \($identity_file)\n" +
             "    IdentitiesOnly yes\n" +
             "    PasswordAuthentication no\n" +
             "    StrictHostKeyChecking accept-new\n" +
             "    UserKnownHostsFile \($known_hosts_file)\n"' \
            <<<"$server_ips"
    } >"$temp_config"
    chmod 600 "$temp_config"
    mv "$temp_config" "$fleet_config"
    trap - EXIT

    if [[ ! -e "$main_config" ]]; then
        install -m 600 /dev/null "$main_config"
    fi

    if ! grep -Fqx "$include" "$main_config"; then
        temp_config=$(mktemp "$ssh_dir/config.XXXXXX")
        trap 'rm -f "$temp_config"' EXIT
        {
            printf '%s\n\n' "$include"
            cat "$main_config"
        } >"$temp_config"
        chmod 600 "$temp_config"
        mv "$temp_config" "$main_config"
        trap - EXIT
    fi

# Install NixOS on the selected new cloud servers.
install host="":
    just _for-hosts _install "$@"

[private]
_install host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    unset SSH_PRIVATE_KEY
    nixos-anywhere \
        --flake "..#{{ host }}" \
        -i "{{ ssh_key }}" \
        --ssh-option "IdentitiesOnly=yes" \
        --ssh-option "ControlMaster=no" \
        --ssh-option "ControlPath=none" \
        --ssh-option "StrictHostKeyChecking=no" \
        --ssh-option "UserKnownHostsFile=/dev/null" \
        "root@$ip"
    just _refresh-host-key {{ host }}
    just _tailscale-login {{ host }}

# Replace the stored SSH host keys after an install or rebuild.
refresh-host-key host="":
    just _for-hosts _refresh-host-key "$@"

[private]
_refresh-host-key host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    mkdir -p "$(dirname "{{ known_hosts }}")"
    touch "{{ known_hosts }}"
    ssh-keygen -f "{{ known_hosts }}" -R "$ip" >/dev/null 2>&1 || true
    for _ in $(seq 1 60); do
        if ssh-keyscan -H "$ip" >> "{{ known_hosts }}" 2>/dev/null; then
            exit 0
        fi
        sleep 2
    done
    echo "Could not read the SSH host key for {{ host }} ($ip)" >&2
    exit 1

# Copy the fleet configuration and its runtime secrets to the selected hosts.
sync host="":
    just _for-hosts _sync "$@"

[private]
_sync host:
    #!/usr/bin/env bash
    set -euo pipefail
    agent_files_env="/etc/nixos/shared/secrets/agent-files-r2.env"
    netrc_file="/etc/nixos/shared/secrets/hyper-video-cachix-netrc.key"
    syncthing_password="/etc/nixos/shared/secrets/syncthing-password.key"
    brave_search_key="/etc/nixos/shared/secrets/brave-search.key"
    openrouter_key="/etc/nixos/shared/secrets/openrouter.key"
    review_bot_env="/etc/nixos/shared/secrets/roberts-review-bot.env"
    review_bot_key="/etc/nixos/shared/secrets/roberts-review-bot.pem"
    fleet_ssh_key="/etc/nixos/shared/secrets/agent-fleet-ssh.key"
    test -f "$agent_files_env"
    test -f "$netrc_file"
    test -f "$syncthing_password"
    test -s "$brave_search_key"
    test -s "$openrouter_key"
    test -s "$review_bot_env"
    test -s "$review_bot_key"
    if [[ "{{ host }}" == "agent-1" ]]; then
        test -s "$fleet_ssh_key"
    fi
    ip=$(just _host-ip {{ host }})
    repository_root=$(git rev-parse --show-toplevel)
    staging=$(mktemp -d)
    trap 'rm -rf -- "$staging"' EXIT

    cd "$repository_root"
    rsync -aR \
        flake.nix \
        flake.lock \
        packages/cliproxyapi/package.nix \
        packages/agent-browser/package.nix \
        agent-fleet/nix/ \
        agent-fleet/ssh/id_ed25519.pub \
        shared/home/agent-files.nix \
        shared/home/mr-boxington.nix \
        shared/linux-home/command-line.nix \
        shared/home/cli-proxy-api.nix \
        shared/home/pi.nix \
        shared/linux/herdr.nix \
        macos/herdr-skill.nix \
        macos/patches/herdr-skill-preferences.patch \
        shared/linux/moshi.nix \
        shared/linux/nix.nix \
        shared/linux/syncthing.nix \
        custom/moshi-hook/ \
        "$staging/"

    ssh=(
        ssh
        -i "{{ ssh_key }}"
        -o IdentitiesOnly=yes
        -o ControlMaster=no
        -o ControlPath=none
        -o UserKnownHostsFile="{{ known_hosts }}"
        -o StrictHostKeyChecking=accept-new
    )
    rsync -az --delete \
        --exclude /shared/secrets/ \
        --rsync-path="sudo rsync" \
        -e "${ssh[*]}" \
        "$staging/" "robert@$ip:/etc/nixos/"
    "${ssh[@]}" "robert@$ip" \
        "sudo install -d -m 710 -o root -g users /etc/nixos/shared/secrets"
    rsync -a \
        --chmod=F600 \
        --chown=root:root \
        --rsync-path="sudo rsync" \
        -e "${ssh[*]}" \
        "$netrc_file" \
        "$syncthing_password" \
        "robert@$ip:/etc/nixos/shared/secrets/"
    rsync -a \
        --chmod=F600 \
        --chown=robert:users \
        --rsync-path="sudo rsync" \
        -e "${ssh[*]}" \
        "$agent_files_env" \
        "$brave_search_key" \
        "$openrouter_key" \
        "$review_bot_env" \
        "$review_bot_key" \
        "robert@$ip:/etc/nixos/shared/secrets/"
    # Give agent-1's roberts-review-bot controller SSH access to burst worker agent-2.
    if [[ "{{ host }}" == "agent-1" ]]; then
        rsync -a \
            --chmod=F600 \
            --chown=robert:users \
            --rsync-path="sudo rsync" \
            -e "${ssh[*]}" \
            "$fleet_ssh_key" \
            "robert@$ip:/etc/nixos/shared/secrets/agent-fleet-ssh.key"
    fi

# Activate the current root flake on the selected hosts.
switch host="":
    just _for-hosts _switch "$@"

[private]
_switch host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    export NIX_SSHOPTS='-i {{ ssh_key }} -o IdentitiesOnly=yes -o ControlMaster=no -o ControlPath=none -o UserKnownHostsFile={{ known_hosts }} -o StrictHostKeyChecking=accept-new'
    nixos-rebuild switch \
        --flake "..#{{ host }}" \
        --target-host "robert@$ip" \
        --sudo

# Copy and activate the current Nix flake.
deploy host="":
    just _for-hosts _deploy "$@"

[private]
_deploy host:
    just _sync {{ host }}
    just _switch {{ host }}
    just _ensure-agent-hooks {{ host }}
    just _sync-ai-resources {{ host }}

# Install or refresh the agent hooks for Herdr and RTK.
ensure-agent-hooks host="":
    just _for-hosts _ensure-agent-hooks "$@"

[private]
_ensure-agent-hooks host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    ssh \
        -i "{{ ssh_key }}" \
        -o IdentitiesOnly=yes \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o UserKnownHostsFile="{{ known_hosts }}" \
        -o StrictHostKeyChecking=accept-new \
        "robert@$ip" 'bash -s' <<'REMOTE'
    set -euo pipefail
    if [[ ! -f "$HOME/.claude/settings.json" ]]; then
        echo "Claude settings have not synced to this host." >&2
        exit 1
    fi
    herdr integration install claude
    herdr integration install codex
    herdr integration install grok
    grok login
    rtk init --global --hook-only --auto-patch
    REMOTE

# Publish Skillshare and refresh lessismore on each host.
sync-ai-resources host="":
    just _for-hosts _sync-ai-resources "$@"

[private]
_sync-ai-resources host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    ssh \
        -i "{{ ssh_key }}" \
        -o IdentitiesOnly=yes \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o UserKnownHostsFile="{{ known_hosts }}" \
        -o StrictHostKeyChecking=accept-new \
        "robert@$ip" 'bash -s' <<'REMOTE'
    set -euo pipefail
    if [[ ! -f "$HOME/projects/ai/skillshare/config.yaml" ]]; then
        echo "The Skillshare source has not synced to this host." >&2
        exit 1
    fi
    if [[ ! -f "$HOME/projects/ai/lessismore/justfile" ]]; then
        echo "The lessismore source has not synced to this host." >&2
        exit 1
    fi
    skillshare sync --all
    # This also bootstraps missing host plugins.
    just --justfile "$HOME/projects/ai/lessismore/justfile" sync
    REMOTE

# Join the selected new hosts to the tailnet (unattended via tailscale-auth.key, or pass --interactive).
tailscale-login host="" *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "${1:-}" == "--interactive" ]]; then
        shift
        just _for-hosts _tailscale-login "" --interactive "$@"
    else
        just _for-hosts _tailscale-login "$@"
    fi

[private]
_tailscale-login host *args:
    #!/usr/bin/env bash
    set -euo pipefail
    host=$1
    shift

    interactive=false
    for arg in "$@"; do
        case "$arg" in
            --interactive)
                interactive=true
                ;;
            *)
                echo "Unknown option for tailscale-login: $arg" >&2
                exit 1
                ;;
        esac
    done

    auth_key_file="/etc/nixos/shared/secrets/tailscale-auth.key"
    auth_key=""
    if [[ "$interactive" == "false" && -s "$auth_key_file" ]]; then
        auth_key=$(tr -d '\r\n' < "$auth_key_file")
    fi

    if [[ -n "$auth_key" ]]; then
        if ! {
            printf 'auth_key=%q\n' "$auth_key"
            cat <<'REMOTE'
    set -euo pipefail
    sudo tailscale up --authkey="$auth_key"
    unset auth_key
    REMOTE
        } | just _ssh "$host" bash; then
            echo "Tailscale auth key failed on $host; falling back to interactive login..." >&2
            just _ssh "$host" sudo tailscale up
        fi
        unset auth_key
    else
        just _ssh "$host" sudo tailscale up
    fi
    just _ssh "$host" sudo systemctl restart tailscale-serve-syncthing.service

# Show the Tailscale connection state for the selected hosts.
tailscale-status host="":
    just _for-hosts _tailscale-status "$@"

[private]
_tailscale-status host:
    just _ssh {{ host }} sudo tailscale status

# Print the tailnet-only Syncthing web UI addresses for the selected hosts.
syncthing-ui host="":
    just _for-hosts _syncthing-ui "$@"

[private]
_syncthing-ui host:
    just _ssh {{ host }} sudo tailscale serve status

# Open the CLI Proxy API control panel of one host in the browser.
serve-cliproxyapi host="agent-1":
    just --justfile ../justfile serve-cliproxyapi "$@"

# Copy local Codex and Claude OAuth credentials to the selected hosts.
sync-auth host="":
    just _for-hosts _sync-auth "$@"

[private]
_sync-auth host:
    #!/usr/bin/env bash
    set -euo pipefail
    test -f "$HOME/.codex/auth.json"
    test -f "$HOME/.claude/.credentials.json"
    ip=$(just _host-ip {{ host }})
    ssh=(
        ssh
        -i "{{ ssh_key }}"
        -o IdentitiesOnly=yes
        -o ControlMaster=no
        -o ControlPath=none
        -o UserKnownHostsFile="{{ known_hosts }}"
        -o StrictHostKeyChecking=accept-new
    )
    "${ssh[@]}" "robert@$ip" 'mkdir -p ~/.codex ~/.claude && chmod 700 ~/.codex ~/.claude'
    rsync -a --chmod=F600 \
        -e "${ssh[*]}" \
        "$HOME/.codex/auth.json" \
        "robert@$ip:.codex/auth.json"
    rsync -a --chmod=F600 \
        -e "${ssh[*]}" \
        "$HOME/.claude/.credentials.json" \
        "robert@$ip:.claude/.credentials.json"

# Print the Syncthing device ID for the selected hosts.
syncthing-id host="":
    just _for-hosts _syncthing-id "$@"

[private]
_syncthing-id host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    ssh \
        -i "{{ ssh_key }}" \
        -o IdentitiesOnly=yes \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o UserKnownHostsFile="{{ known_hosts }}" \
        -o StrictHostKeyChecking=accept-new \
        "robert@$ip" \
        'syncthing device-id --home="$HOME/.config/syncthing"'

# Show Syncthing progress for the fleet folders.
sync-status host="":
    just _for-hosts _sync-status "$@"

[private]
_sync-status host:
    #!/usr/bin/env bash
    set -euo pipefail
    ip=$(just _host-ip {{ host }})
    ssh \
        -i "{{ ssh_key }}" \
        -o IdentitiesOnly=yes \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o UserKnownHostsFile="{{ known_hosts }}" \
        -o StrictHostKeyChecking=accept-new \
        "robert@$ip" 'bash -s' <<'REMOTE'
    set -euo pipefail
    api_key=$(syncthing cli -H "$HOME/.config/syncthing" config gui apikey get)
    for folder in configs projects/ai projects/home projects/hyper; do
        curl -fsS \
            -H "X-API-Key: $api_key" \
            --get \
            --data-urlencode "folder=$folder" \
            http://127.0.0.1:8384/rest/db/status \
            | jq -c --arg folder "$folder" '{folder: $folder, state: .state, globalBytes: .globalBytes, localBytes: .localBytes, needBytes: .needBytes, errors: .errors}'
    done
    REMOTE

# Open an SSH session as robert, or run the given command.
ssh host="" *command:
    just _for-hosts _ssh "$@"

[private]
_ssh host *command:
    #!/usr/bin/env bash
    set -euo pipefail
    host=$1
    shift
    ip=$(just _host-ip "$host")
    ssh \
        -i "{{ ssh_key }}" \
        -o IdentitiesOnly=yes \
        -o ControlMaster=no \
        -o ControlPath=none \
        -o UserKnownHostsFile="{{ known_hosts }}" \
        -o StrictHostKeyChecking=accept-new \
        "robert@$ip" "$@"

# Build the selected NixOS hosts locally without activating them.
build host="":
    just _for-hosts _build "$@"

[private]
_build host:
    nix build "..#nixosConfigurations.{{ host }}.config.system.build.toplevel"

# Update every Nix flake input.
update-inputs:
    nix flake update --flake ..

# Update the pinned Moshi hook release.
update-moshi:
    just --justfile ../justfile update-moshi

# Pair one fleet host with the Moshi phone app.
pair-moshi host:
    @./scripts/pair-moshi "{{ host }}"

# Provision or resume burst worker agent-2 (newest snapshot or debian-12) and prefer it on agent-1.
burst-on image="" fresh="false":
    @./scripts/burst on "$1" "$2"

# Show burst worker server, persistent volume, latest snapshot, and agent-1 controller status.
burst-status:
    @./scripts/burst status

# Drain agent-2 reviews back to agent-1, stop Herdr cleanly, and power off agent-2.
burst-off:
    @./scripts/burst off

# Drain agent-2, power it off, and create a labeled Hetzner snapshot (leaves agent-2 powered off).
burst-snapshot:
    @./scripts/burst snapshot

# Drain, unmount /mnt/agent-2-data, optionally snapshot, and remove agent-2 compute (retains volume).
burst-delete snapshot="true":
    @./scripts/burst delete "$1"
